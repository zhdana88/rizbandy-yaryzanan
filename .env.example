# Public browser configuration. VITE_ variables are included in the client bundle.
# Uncomment and set this only if the frontend needs to call a public API.
# VITE_API_BASE_URL=http://localhost:3001

# Public Supabase project settings (safe to expose with database RLS enabled).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Server-only Cloudflare AI Gateway settings. Never use a VITE_ prefix here.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_AI_GATEWAY_ID=your-ai-gateway-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# Read by vite.config.ts; this is not exposed through import.meta.env.
DISABLE_HMR=false

# Keep all provider and gateway secrets on the server. Never add them to VITE_ variables.
